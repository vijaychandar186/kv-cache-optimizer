# Export these in the Linux shell before running the server. Do not commit real values.
HF_HOME=/home/azureuser/.cache/huggingface
# Public OLMo weights do not require HF_TOKEN. Set it only if needed.
# HF_TOKEN=...
VLLM_API_KEY=replace-with-a-random-secret
TOKENIZERS_PARALLELISM=false
VLLM_NO_USAGE_STATS=1
